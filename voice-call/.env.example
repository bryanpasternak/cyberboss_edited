# ── MiniMax 凭据(TTS,必填)──────────────────────────────
# 后台 https://platform.minimaxi.com/ → 账户信息 里拿
# ⚠️ 真凭据填到 .env(已被 gitignore),别填这个模板文件
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# TTS 配置
MINIMAX_BASE=https://api.minimaxi.com
MINIMAX_TTS_MODEL=speech-02-turbo
# 音色 id,默认一个系统男声;可换成你克隆的音色
MINIMAX_VOICE_ID=Chinese_radio_host_male_nv1

# ── 硅基流动 SenseVoice(STT/语音识别)────────────────────
# 注册 https://cloud.siliconflow.cn/ → API 密钥 → 新建,复制 sk-...
# 留空时:服务器跳过识别,直接 TTS 回固定测试话(先验证录麦+播放)。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ── 回复模式 ─────────────────────────────────────────────
# echo      = 回显"你刚才说:xxx"(不依赖 claude,调链路时用)
# cyberboss = 拉起 claude -p,自动加载 CLAUDE.md 阿星人设,真对话
REPLY_MODE=echo
CLAUDE_CMD=claude
CLAUDE_WORKSPACE=..
# 模型: haiku 最快(~3.5s) / sonnet 更像阿星但慢 ~4s
CLAUDE_MODEL=haiku
# MCP 档位: none=零MCP最快,记忆靠 anchor 注入 / full=加载ombre-brain实时记忆但慢~5s / 也可填某个mcp配置json的绝对路径
VOICE_MCP=none

# ── 服务 ────────────────────────────────────────────────
PORT=8787
