# =============================================================================
# Cyberboss .env.example
# =============================================================================
# 用法：复制为 .env 并按需填写。值带空格的不要加引号，路径直接写绝对路径。
# 留空表示走代码默认值（默认值见 src/core/config.js）。
# =============================================================================


# -----------------------------------------------------------------------------
# 用户身份（必填）
# -----------------------------------------------------------------------------
# 显示在指令模板里的称呼。
CYBERBOSS_USER_NAME=
# female / male / other —— 影响生成内容里的代词。
CYBERBOSS_USER_GENDER=female
# 微信端允许触发 bot 的 wxid 白名单（逗号分隔）。
# 不在名单里的人发消息会被忽略。可以先填一个自己的 wxid。
CYBERBOSS_ALLOWED_USER_IDS=


# -----------------------------------------------------------------------------
# 工作目录（必填）
# -----------------------------------------------------------------------------
# 项目根目录的绝对路径。Windows 下用反斜杠或正斜杠都行。
CYBERBOSS_WORKSPACE_ROOT=


# -----------------------------------------------------------------------------
# 渠道开关（多渠道改造后新增）
# -----------------------------------------------------------------------------
# 启用的渠道，逗号分隔。可选：weixin / telegram。
# 仅微信：weixin
# 仅 telegram：telegram
# 双端共享上下文：weixin,telegram
CYBERBOSS_CHANNELS=weixin

# 还没建立 last-active 记录时（用户第一次没说话就触发出站）默认走哪个渠道。
CYBERBOSS_DEFAULT_OUTBOUND_CHANNEL=weixin


# -----------------------------------------------------------------------------
# 微信渠道
# -----------------------------------------------------------------------------
# 多账号时显式选一个；单账号留空即可。
CYBERBOSS_ACCOUNT_ID=
# 微信回复短消息合并的最小字符数；不熟就留空，默认 20。
CYBERBOSS_WEIXIN_MIN_CHUNK_CHARS=


# -----------------------------------------------------------------------------
# Telegram 渠道（CYBERBOSS_CHANNELS 包含 telegram 时才需要）
# -----------------------------------------------------------------------------
# 推荐做法：用 `node bin/cyberboss.js login --channel telegram` 走交互式登录，
# token 会被写到 ~/.cyberboss/accounts/telegram-<botId>.json 里，加密保管，
# 这样下面的 CYBERBOSS_TELEGRAM_BOT_TOKEN 可以留空。
#
# 如果想直接用环境变量也可以填这里——优先级：env > account 文件。
CYBERBOSS_TELEGRAM_BOT_TOKEN=

# 自定义 Bot API 地址（用第三方反代或本地 server 时才填，留空走官方）。
CYBERBOSS_TELEGRAM_API_BASE_URL=

# 允许触发 bot 的 TG chat_id 白名单（逗号分隔）。
# 留空 = 任何人发都会进流程；强烈建议先填上自己的 chat_id 防陌生人。
# 拿 chat_id 的方法：随便发一条给 bot，bot 会先回提示让你 /link，
# 同时控制台日志里会打 chatId=...
CYBERBOSS_TELEGRAM_ALLOWED_CHAT_IDS=

# TG 端是否展示模型思考链（折叠 blockquote）。默认 true。
# 关闭：CYBERBOSS_TELEGRAM_SHOW_THINKING=false
CYBERBOSS_TELEGRAM_SHOW_THINKING=true

# Telegram 回复短消息合并的最小字符数；不熟就留空，默认 20。
CYBERBOSS_TELEGRAM_MIN_CHUNK_CHARS=

# 代理（国内访问 api.telegram.org 需要）。优先级：
#   CYBERBOSS_TELEGRAM_PROXY > HTTPS_PROXY > HTTP_PROXY
# 把 7890 换成你代理客户端（Clash/Mihomo/sing-box/v2rayN 等）暴露的本地 HTTP 代理端口。
# Clash 系默认 7890，v2rayN 默认 10809。
# 也支持 socks5：CYBERBOSS_TELEGRAM_PROXY=socks5://127.0.0.1:7891
CYBERBOSS_TELEGRAM_PROXY=
# HTTPS_PROXY=http://127.0.0.1:7890


# -----------------------------------------------------------------------------
# 运行时（runtime）
# -----------------------------------------------------------------------------
# claudecode / codex；默认 codex。
CYBERBOSS_RUNTIME=claudecode

# claude CLI 的可执行路径。Windows 下通常在 npm 全局目录里。
# 通过 `where claude`（PowerShell 用 `Get-Command claude`）查得到。
CYBERBOSS_CLAUDE_COMMAND=

# claudecode 上下文窗口（tokens）；不填 /status 里看不到剩余进度。
# Sonnet 4.x 一般填 200000，Opus 也是 200000。
CYBERBOSS_CLAUDE_CONTEXT_WINDOW=
# claude 输出预留 token 上限。默认走 SDK 自带值。
CLAUDE_CODE_MAX_OUTPUT_TOKENS=

# Codex 才用的几个：
CYBERBOSS_CODEX_ENDPOINT=
CYBERBOSS_CODEX_COMMAND=
CYBERBOSS_CODEX_MODEL=
CYBERBOSS_CODEX_MODEL_PROVIDER=


# -----------------------------------------------------------------------------
# 视觉识图（可选）
# -----------------------------------------------------------------------------
# auto / vision_call / vision_attachment / off —— 默认 auto。
CYBERBOSS_VISION_MODE=auto
# openai-compatible 协议的视觉服务（Qwen / OpenRouter / 自托管 vLLM 等）。
CYBERBOSS_VISION_API_BASE_URL=
CYBERBOSS_VISION_API_KEY=
CYBERBOSS_VISION_MODEL=


# -----------------------------------------------------------------------------
# 主动 check-in / 位置上报（可选）
# -----------------------------------------------------------------------------
# 启动时是否自动跑 check-in 轮询。微信里 /checkin <min>-<max> 也能改区间。
CYBERBOSS_ENABLE_CHECKIN=

# 启动时是否拉起本机位置 webhook 服务。
CYBERBOSS_ENABLE_LOCATION_SERVER=

# 可选：覆盖新线程开场时注入的通用操作说明文件。
# 适合为独立的代码机器人提供纯工程说明，避免继承默认陪伴/主动联系规则。
CYBERBOSS_WEIXIN_OPERATIONS_FILE=
# 监听 host/port —— 反代或局域网部署时改。
CYBERBOSS_LOCATION_HOST=0.0.0.0
CYBERBOSS_LOCATION_PORT=4318
# 客户端上报的鉴权 token，留空 = 不校验。
CYBERBOSS_LOCATION_TOKEN=
# 已知地点中心点（用于"到家/离家"触发）。格式 "lat,lng"。
CYBERBOSS_LOCATION_HOME_CENTER=
CYBERBOSS_LOCATION_WORK_CENTER=


# -----------------------------------------------------------------------------
# Timeline / 其他
# -----------------------------------------------------------------------------
# timeline-for-agent 的语种。
TIMELINE_FOR_AGENT_LOCALE=zh-CN
